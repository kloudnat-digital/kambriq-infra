# ============================================================================
# Fichier d'exemple de variables Terraform pour l'environnement DEV
# ============================================================================
#
# UTILISATION :
# 1. Copier ce fichier vers terraform.tfvars :
#    cp terraform.tfvars.example terraform.tfvars
#
# 2. Remplacer les valeurs placeholder (CHANGE_ME_*) par les vraies valeurs
#    - Utiliser un gestionnaire de secrets (Vault, LastPass, 1Password, etc.)
#    - Ne jamais commiter terraform.tfvars dans Git (déjà dans .gitignore)
#
# 3. Pour le déploiement via GitHub Actions, les secrets sont gérés via
#    GitHub Secrets (Settings → Secrets and variables → Actions)
#
# 4. IMPORTANT : Le stack "shared" doit être déployé AVANT ce stack
#
# ============================================================================

# Région AWS où déployer l'infrastructure
aws_region = "eu-central-1"

# Mot de passe maître de la base de données PostgreSQL
# ⚠️  Utiliser un mot de passe fort (min. 16 caractères, majuscules, minuscules, chiffres, symboles)
# ⚠️  En production, préférer AWS Secrets Manager
db_password = "CHANGE_ME_STRONG_PASSWORD"

# Secret JWT pour l'authentification de l'API
# ⚠️  Utiliser une clé secrète forte et aléatoire (min. 32 caractères recommandés)
# ⚠️  En production, préférer AWS Secrets Manager
jwt_secret = "CHANGE_ME_JWT_SECRET_KEY"

# ============================================================================
# Domaines personnalisés (optionnel - pour DEV)
# ============================================================================
# Par défaut, CloudFront et API Gateway utilisent leurs URLs par défaut.
# Pour activer des domaines personnalisés, décommenter et remplir :

# cloudfront_domain          = "app-dev.kambriq.com"
# cloudfront_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"

# api_domain                = "api-dev.kambriq.com"
# api_certificate_arn        = "arn:aws:acm:eu-central-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"
#
# Note : Les certificats peuvent être récupérés depuis le stack "shared" :
# terraform output -state=../shared/terraform.tfstate api_certificate_arn
