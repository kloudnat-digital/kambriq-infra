# Exemple de fichier terraform.tfvars pour l'environnement prod
# Copier ce fichier vers terraform.tfvars et remplir les valeurs

aws_region = "eu-central-1"

# Mot de passe de la base de données (utiliser un secret manager en production)
db_password = "CHANGE_ME_STRONG_PASSWORD"

# Secret JWT pour l'authentification
jwt_secret = "CHANGE_ME_JWT_SECRET_KEY"

# Configuration SES
ses_domain     = "kambriq.com"
ses_from_email = "noreply@kambriq.com"

# Domaines personnalisés (optionnel)
# cloudfront_domain          = "app.kambriq.com"
# cloudfront_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT:certificate/CERT_ID"
# api_domain                = "api.kambriq.com"
# api_certificate_arn        = "arn:aws:acm:eu-west-1:ACCOUNT:certificate/CERT_ID"

