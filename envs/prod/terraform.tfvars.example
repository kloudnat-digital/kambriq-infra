# ============================================================================
# Fichier d'exemple de variables Terraform pour l'environnement PROD
# ============================================================================
#
# UTILISATION :
# 1. Copier ce fichier vers terraform.tfvars :
#    cp terraform.tfvars.example terraform.tfvars
#
# 2. Remplacer les valeurs placeholder (CHANGE_ME_*) par les vraies valeurs
#    - ⚠️  EN PRODUCTION : Utiliser OBLIGATOIREMENT un gestionnaire de secrets
#      (AWS Secrets Manager, HashiCorp Vault, etc.)
#    - Ne jamais commiter terraform.tfvars dans Git (déjà dans .gitignore)
#
# 3. Pour le déploiement via GitHub Actions, les secrets sont gérés via
#    GitHub Secrets (Settings → Secrets and variables → Actions)
#
# 4. IMPORTANT : Le stack "shared" doit être déployé AVANT ce stack
#
# 5. Le déploiement en production se fait principalement via GitHub Actions
#    (workflow déclenché sur push vers la branche main)
#
# ============================================================================

# Région AWS où déployer l'infrastructure
aws_region = "eu-central-1"

# Mot de passe maître de la base de données PostgreSQL
# ⚠️  PRODUCTION : Utiliser AWS Secrets Manager ou un autre gestionnaire de secrets
# ⚠️  Utiliser un mot de passe fort (min. 16 caractères, majuscules, minuscules, chiffres, symboles)
db_password = "CHANGE_ME_STRONG_PASSWORD"

# Secret JWT pour l'authentification de l'API
# ⚠️  PRODUCTION : Utiliser AWS Secrets Manager ou un autre gestionnaire de secrets
# ⚠️  Utiliser une clé secrète forte et aléatoire (min. 32 caractères recommandés)
jwt_secret = "CHANGE_ME_JWT_SECRET_KEY"

# ============================================================================
# Domaines personnalisés (recommandé pour PROD)
# ============================================================================
# Pour activer des domaines personnalisés en production :
#
# 1. Récupérer les certificats depuis le stack "shared" :
#    cd ../shared
#    terraform output api_certificate_arn
#    # Pour CloudFront, créer un certificat dans us-east-1 séparément
#
# 2. Configurer les domaines dans Route53 (dans le stack shared) :
#    - app.kambriq.com → CloudFront distribution
#    - api.kambriq.com → API Gateway
#
# 3. Décommenter et remplir les valeurs ci-dessous :

# cloudfront_domain          = "app.kambriq.com"
# cloudfront_certificate_arn = "arn:aws:acm:us-east-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"
#
# api_domain                = "api.kambriq.com"
# api_certificate_arn        = "arn:aws:acm:eu-central-1:ACCOUNT_ID:certificate/CERTIFICATE_ID"
#
# Note : Le certificat API peut être récupéré depuis le stack "shared" :
# terraform output -state=../shared/terraform.tfstate api_certificate_arn
